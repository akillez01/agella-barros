# Porta interna do container (o compose publica em 127.0.0.1:3006 -> 3001)
PORT=3001

# Preenchido automaticamente pelo docker-compose.yml a partir do serviço "postgres"
DATABASE_URL=postgresql://angellabarros:CHANGE_ME@postgres:5432/angellabarros

# Origem do front-end (CORS) — mesmo domínio, mas fica explícito
FRONTEND_URL=https://angellabarros.com

# Pasta de upload de mídia em disco local (padrão usado no Corrente de Apoio Portal,
# sem S3). Fora do container isso é um volume mapeado para
# /var/www/vhosts/angellabarros.com/data/uploads no host.
UPLOAD_DIR=/app/uploads

# ==== Chat da Bela (IA) ====
# Necessário para o endpoint /api/ai/chat responder de verdade.
# Sem essa variável, o endpoint retorna 501 (erro controlado, não quebra o site).
# Gere em https://console.anthropic.com/ e cole aqui (ou no .env real do servidor).
ANTHROPIC_API_KEY=sk-ant-COLE_AQUI
